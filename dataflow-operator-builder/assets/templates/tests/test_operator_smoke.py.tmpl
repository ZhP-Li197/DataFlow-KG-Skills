import json
from pathlib import Path

from dataflow.utils.storage import FileStorage
from {{PUBLIC_IMPORT_PATH}} import {{OPERATOR_CLASS_NAME}}


[[IF_USES_LLM]]
class _DummyLLM:
    def generate_from_input(self, user_inputs, system_prompt, json_schema=None):
        return ['{"ok": true}' for _ in user_inputs]
[[END_IF_USES_LLM]]


def test_smoke_run_with_filestorage(tmp_path):
    input_path = tmp_path / "input.jsonl"
    record = {"{{INPUT_KEY}}": "demo input"[[IF_HAS_META_INPUT]], "{{INPUT_KEY_META}}": "demo meta"[[END_IF_HAS_META_INPUT]]}
    input_path.write_text(json.dumps(record, ensure_ascii=False) + "\n", encoding="utf-8")

    storage = FileStorage(
        first_entry_file_name=str(input_path),
        cache_path=str(tmp_path),
        file_name_prefix="builder_smoke",
        cache_type="jsonl",
    )

[[IF_USES_LLM]]
    operator = {{OPERATOR_CLASS_NAME}}(llm_serving=_DummyLLM())
[[END_IF_USES_LLM]]
[[IF_NOT_USES_LLM]]
    operator = {{OPERATOR_CLASS_NAME}}()
[[END_IF_NOT_USES_LLM]]

    result = operator.run(
        storage=storage.step(),
        input_key="{{INPUT_KEY}}",
[[IF_HAS_META_INPUT]]
        input_key_meta="{{INPUT_KEY_META}}",
[[END_IF_HAS_META_INPUT]]
        output_key="{{OUTPUT_KEY}}",
    )

    assert result == ["{{OUTPUT_KEY}}"]

    output_file = Path(tmp_path) / "builder_smoke_step1.jsonl"
    assert output_file.exists()

    lines = [line for line in output_file.read_text(encoding="utf-8").splitlines() if line.strip()]
    assert lines
    first_row = json.loads(lines[0])
    assert "{{OUTPUT_KEY}}" in first_row

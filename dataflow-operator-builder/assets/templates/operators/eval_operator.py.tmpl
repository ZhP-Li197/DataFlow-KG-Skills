    def _parse_llm_response(self, response: Any) -> Any:
        if response is None:
            return 0
        if not isinstance(response, str):
            return response
        cleaned = re.sub(r"```json|```", "", response).strip()
        if not cleaned:
            return 0
        try:
            return json.loads(cleaned)
        except Exception:
            try:
                return float(cleaned)
            except Exception:
                return cleaned
